# Copy to .env.local (never commit real values). On Vercel: `vercel env add <NAME>`.

# --- Dev ---------------------------------------------------------------------
# 1 = agents use the mock Neuralake client (no API key needed).
FINN_USE_MOCKS=0
# Shared secret for /api/orchestrator (Authorization: Bearer ...).
# Generate: openssl rand -hex 32. The PWA asks for it once and keeps it on the phone.
FINN_API_TOKEN=
# Own secret for the A2A endpoint POST /api/agents/* (Authorization: Bearer ...). The Agent Card stays public.
# Format: exactly 64 hex characters, random (same rule as FINN_SESSION_SECRET). Generate: openssl rand -hex 32.
# MUST differ from FINN_API_TOKEN. Without this variable (or if invalid/equal) the A2A endpoint is OFF (503);
# FINN_API_TOKEN does not open it.
FINN_A2A_TOKEN=

# --- Neuralake (orchestration LLM) ------------------------------------------
# The key shown in the design screenshot is compromised: rotate it first.
NEURALAKE_API_KEY=
NEURALAKE_BASE_URL=https://api.neuralake.cloud/v1
NEURALAKE_MODEL=auto

# --- Spotify (feat/spotify-agent) -------------------------------------------
# App at https://developer.spotify.com/dashboard (Web API). Scopes requested:
# user-modify-playback-state user-read-playback-state playlist-read-private playlist-read-collaborative
# Playback control needs Spotify Premium and Spotify open on some device.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI registered in the dashboard byte-for-byte. Spotify
# rejects `localhost` for http: use the loopback IP locally, and open
# http://127.0.0.1:3000/api/spotify/login (not localhost) to start the flow.
# Production: https://<your-domain>/api/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
# Obtained once via /api/spotify/login, then stored here (no database).
SPOTIFY_REFRESH_TOKEN=

# --- Waze (feat/waze-agent) -------------------------------------------------
# Optional saved places, JSON: {"casa":"Rua Augusta, 123, São Paulo","trabalho":"Av. Paulista, 1000"}
# Addresses dictated by the driver are kept only in memory (lost on cold starts)
# until Neuralake agent memory is wired, so put long-lived ones here.
WAZE_SAVED_ADDRESSES=

# --- Groq STT (Fast pt-BR Whisper) -------------------------------------------
# Whisper-large-v3-turbo via Groq (~200ms latency, free tier available).
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Voice & Speech Providers ------------------------------------------------
# STT_PROVIDER: auto-detects groq if GROQ_API_KEY is present, else openai. Set to "openai" or "groq" to override.
STT_PROVIDER=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# --- OpenAI GPT-Live-1 (feat/pwa-voice) -------------------------------------
# Server-only: /api/realtime/session uses it to exchange the browser's WebRTC
# SDP offer with POST /v1/live/sessions. Never sent to the browser.
# The project needs GPT-Live access (not available on the Free tier).
OPENAI_API_KEY=
# Optional GPT-Live voice. pt-BR voices: tempo (masculine, default) or bossa (feminine).
OPENAI_LIVE_VOICE=tempo

# --- Picovoice Porcupine (feat/pwa-voice) -----------------------------------
# Porcupine runs in the browser, so this AccessKey is necessarily public.
# Also add the keyword/params files to public/porcupine/ (see its README.md).
NEXT_PUBLIC_PICOVOICE_ACCESS_KEY=

# --- Driver identity (etapa 1, entrega 2) -----------------------------------
# Names and formats only; values are the owner's, distinct per environment.
# 64 hex characters (32 bytes): openssl rand -hex 32. Signs session tokens (v1.*).
FINN_SESSION_SECRET=
# 64 hex characters, MUST differ from FINN_SESSION_SECRET. Peppers the invite key hash;
# changing it invalidates every invite already issued.
FINN_INVITE_PEPPER=
# Exactly 1 enables the legacy shared FINN_API_TOKEN on /api/orchestrator and /api/realtime/*
# (transitional, until the new PWA). Absent, empty, "true", "0" or anything else = off.
FINN_LEGACY_TOKEN_ENABLED=
# Owner scripts (invite:*, driver:*) read KV_REST_API_URL, KV_REST_API_TOKEN and FINN_INVITE_PEPPER
# from a file YOU keep outside the repo: npm run -s invite:create -- --env preview --env-file <path> --label "Nome"
# (Node itself loads --env-file; variables already in the process environment win over the file.)
