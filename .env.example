# Copy to .env.local (never commit real values). On Vercel: `vercel env add <NAME>`.

# --- Dev ---------------------------------------------------------------------
# 1 = agents use the mock Neuralake client (no API key needed).
FINN_USE_MOCKS=0
# Shared secret for /api/orchestrator and /api/agents/* (Authorization: Bearer ...).
# Generate: openssl rand -hex 32. The PWA asks for it once and keeps it on the phone.
FINN_API_TOKEN=

# --- Neuralake (orchestration LLM) ------------------------------------------
# The key shown in the design screenshot is compromised: rotate it first.
NEURALAKE_API_KEY=
NEURALAKE_BASE_URL=https://api.neuralake.cloud/v1
NEURALAKE_MODEL=auto

# --- Spotify (feat/spotify-agent) -------------------------------------------
# App at https://developer.spotify.com/dashboard (Web API). Scopes requested:
# user-modify-playback-state playlist-read-private playlist-read-collaborative
# Playback control needs Spotify Premium and Spotify open on some device.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI registered in the dashboard byte-for-byte. Spotify
# rejects `localhost` for http: use the loopback IP locally, and open
# http://127.0.0.1:3000/api/spotify/login (not localhost) to start the flow.
# Production: https://<your-domain>/api/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
# Obtained once via /api/spotify/login, then stored here (no database).
SPOTIFY_REFRESH_TOKEN=

# --- Waze (feat/waze-agent) -------------------------------------------------
# Optional saved places, JSON: {"casa":"Rua Augusta, 123, São Paulo","trabalho":"Av. Paulista, 1000"}
# Addresses dictated by the driver are kept only in memory (lost on cold starts)
# until Neuralake agent memory is wired, so put long-lived ones here.
WAZE_SAVED_ADDRESSES=

# --- OpenAI GPT-Live-1 (feat/pwa-voice) -------------------------------------
# Server-only: used to mint ephemeral client tokens, never sent to the browser.
OPENAI_API_KEY=

# --- Picovoice Porcupine (feat/pwa-voice) -----------------------------------
# Porcupine runs in the browser, so this AccessKey is necessarily public.
NEXT_PUBLIC_PICOVOICE_ACCESS_KEY=
